{
  "manifest_version": 3,
  "name": "WikiTree Quellenbilder-Assistent",
  "version": "0.18.0",
  "description": "Findet Quellen-Links (Matricula, DFG-Viewer/Landesarchiv NRW, Landesarchiv BW, Arcinsys, Wielkopolska Digital Library/dLibra u.a.) in einem geöffneten WikiTree-Profil und hilft, korrekte Quellenangaben (und wenn möglich eine Bildvorschau) in den Bio-Editor einzufügen.",
  "permissions": [
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://www.wikitree.com/*",
    "https://api.wikitree.com/*",
    "https://*.matricula-online.eu/*",
    "https://matricula-online.eu/*",
    "https://*.landesarchiv-nrw.de/*",
    "https://landesarchiv-nrw.de/*",
    "https://dfg-viewer.de/*",
    "https://*.arcinsys.hessen.de/*",
    "https://arcinsys.hessen.de/*",
    "https://*.arcinsys.de/*",
    "http://*.arcinsys.de/*",
    "https://*.landesarchiv-bw.de/*",
    "http://*.landesarchiv-bw.de/*",
    "https://*.wbc.poznan.pl/*",
    "https://wbc.poznan.pl/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.wikitree.com/wiki/*", "https://www.wikitree.com/index.php*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
